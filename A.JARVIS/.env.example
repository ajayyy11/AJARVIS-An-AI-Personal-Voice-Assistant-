# A.JARVIS Environment Configuration
# Copy this file to .env. Replace every placeholder before use.
# Gemini/Weather keys are optional for local-only commands; their related features need them.

SECRET_KEY=your_super_secret_key_here

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_USER=ajarvis_user
MYSQL_PASSWORD=your_db_password_here
MYSQL_DB=ajarvis_db

GEMINI_API_KEY=your_gemini_key_here

WEATHER_API_KEY=your_weather_api_key_here
DEFAULT_CITY=London

SESSION_TIMEOUT_MINUTES=30
# Lower thresholds are stricter. Validate against your own camera before relying on it.
FACE_MATCH_THRESHOLD=0.55
# Set true only when serving over HTTPS; local http://127.0.0.1 development should leave this false.
SESSION_COOKIE_SECURE=false
